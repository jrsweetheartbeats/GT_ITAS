# Copy to .env and source it, or export these values in the service environment.
# Never commit the real .env file.
AUDIT_FLOW_DB_DRIVER=mariadb+pymysql
AUDIT_FLOW_DB_HOST=127.0.0.1
AUDIT_FLOW_DB_PORT=3306
AUDIT_FLOW_DB_USER=itas_user
AUDIT_FLOW_DB_PASSWORD=CHANGE_ME
AUDIT_FLOW_DB_NAME=ITAS
# Separate SELECT-only account used by SQL practice questions. Do not reuse the ITAS application account.
AUDIT_FLOW_PRACTICE_DB_URL=mariadb+pymysql://itas_practice:CHANGE_ME@127.0.0.1:3306/?charset=utf8mb4
AUDIT_FLOW_INITIAL_ADMIN_PASSWORD=CHANGE_ME
AUDIT_FLOW_AUTOFILL_RULES_PATH=/path/to/private/autofill_rules.json
AUDIT_FLOW_SEARCH_ROOT=/path/to/project/workpapers
AUDIT_FLOW_PORT=8010
