# Copy to .env on the deployment host. Do not commit the real .env file.
AUDIT_FLOW_ENV=production
AUDIT_FLOW_DB_DRIVER=mariadb+pymysql
AUDIT_FLOW_DB_HOST=127.0.0.1
AUDIT_FLOW_DB_PORT=3306
AUDIT_FLOW_DB_USER=itas_user
AUDIT_FLOW_DB_PASSWORD=CHANGE_ME
AUDIT_FLOW_DB_NAME=ITAS
AUDIT_FLOW_INITIAL_ADMIN_PASSWORD=CHANGE_ME
AUDIT_FLOW_SESSION_TTL_MINUTES=480
# Comma-separated browser origins. Do not use *.
AUDIT_FLOW_CORS_ORIGINS=https://itas.example.com
AUDIT_FLOW_PROJECTS_ROOT=/srv/itas/project_files
